<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="health_users_form_view" model="ir.ui.view">
            <field name="name">health.users.form</field>
            <field name="model">health.users</field>
            <field name="arch" type="xml">
                <form string="Health User">
                    <sheet>
                        <div class="oe_title">
                            <label for="email"/>
                            <h1>
                                <field name="email" placeholder="Email"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="subscription_type" widget="selection"/>
                                <field name="expiry"/>
                            </group>
                            <group>
                                <field name="password" password="True"/>
                                <field name="secret_key"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="health_users_tree_view" model="ir.ui.view">
            <field name="name">health.users.tree</field>
            <field name="model">health.users</field>
            <field name="arch" type="xml">
                <list string="Health Users" sample="True">
                    <field name="email"/>
                    <field name="subscription_type"/>
                    <field name="expiry"/>
                </list>
            </field>
        </record>

        <record id="health_users_search_view" model="ir.ui.view">
            <field name="name">health.users.search</field>
            <field name="model">health.users</field>
            <field name="arch" type="xml">
                <search string="Health Users">
                    <group expand="1" string="Group By">
                        <filter string="Subscription Type" name="subscription_type" domain="[]"
                                context="{'group_by':'subscription_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="health_users_act_window" model="ir.actions.act_window">
            <field name="name">Health Users</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">health.users</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No records found!
                </p>
            </field>
        </record>

        <menuitem name="Health Users" id="health_users_menu" action="health_users_act_window"/>

    </data>
</odoo>