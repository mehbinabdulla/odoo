<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Define a view to extend POS configuration settings with delivery options -->
    <record id="view_pos_configuration_form" model="ir.ui.view">
        <field name="name">pos.config.view.form.inherit.pos.order.types</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='product_and_category_block']//setting[last()]" position="after">
                <setting id="website_product_bom_setting" help="Set discount limit based on POS Categories">
                    <field name="is_discount_limit" string="Limit Discount"/>
                    <div class="content-group mt16" invisible="not is_discount_limit">
                        <field name="category_ids">
                            <list editable="bottom">
                                <field name="name" string="Category" readonly="True"/>
                                <field name="discount_limit" string="Limit" widget="percentage"/>
                            </list>
                        </field>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
