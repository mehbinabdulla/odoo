<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_product.DiscountLimit">
        <Dialog>
            <t t-set-slot="header">
                <h4 class="modal-title"><span t-out="props.title"/></h4>
                <button type="button" class="btn-close" aria-label="Close" t-on-click="confirm" tabindex="-1"/>
            </t>
            <div class="body">
                <span t-out="props.body"/>
            </div>
            <t t-set-slot="footer">
                <div class="modal-footer-left d-flex gap-2">
                    <div class="modal-footer-left d-flex gap-2">
                        <button class="button highlight btn btn btn-primary" t-on-click="confirm">OK</button>
                    </div>
                </div>
            </t>
        </Dialog>
    </t>

</templates>

