<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="survey_survey_form_inherit" model="ir.ui.view">
            <field name="name">survey.survey.form</field>
            <field name="model">survey.survey</field>
            <field name="inherit_id" ref="survey.survey_survey_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//notebook" position="inside">
                    <page string="Contact Relations" name="contact_relations">
                        <field name="survey_contact_ids" readonly="False">
                            <list editable="bottom">
                                <field name="question_id"/>
                                <field name="partner_field"/>
                            </list>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>