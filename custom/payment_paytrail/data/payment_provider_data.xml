<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
   <record id="payment_method_paytrail" model="payment.method">
        <field name="name">Paytrail Payment Gateway</field>
        <field name="code">paytrail_gateway</field>
        <field name="sequence">1</field>
        <field name="active">True</field>
        <field name="image" type="base64" file="payment_paytrail/static/description/icon.png"/>
        <field name="support_tokenization">True</field>
        <field name="support_express_checkout">False</field>
        <field name="support_refund">partial</field>
    </record>

   <record id="payment_provider_paytrail" model="payment.provider">
      <field name="name">Paytrail</field>
      <field name="sequence">1</field>
      <field name="company_id" ref="base.main_company"/>
      <field name="image_128" type="base64" file="payment_paytrail/static/description/icon.png"/>
      <field name="state">test</field>
      <field name="support_refund">partial</field>
      <field name="support_tokenization">True</field>
      <field name="allow_tokenization">True</field>
      <field name="is_published">True</field>
      <field name="code">paytrail</field>
      <field name="redirect_form_view_id" ref="payment_paytrail.paytrail_redirect_form"/>
      <field name="paytrail_merchant_id">375917</field>
      <field name="paytrail_secret_key">SAIPPUAKAUPPIAS</field>
      <field name="payment_method_ids"
         eval="[Command.set([
                   ref('payment_method_paytrail'),
               ])]"
      />
   </record>
</odoo>