<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upload_sale_order_line_wizard_form" model="ir.ui.view">
        <field name="name">upload.sale.order.line.wizard.form</field>
        <field name="model">upload.sale.order.line.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="file" filename="file_name" widget="file" />
                </group>
                <footer>
                    <button string="Import"
                            data-hotkey="q"
                            name="action_upload_file"
                            type="object"
                            class="print btn-primary o_mail_send">
                    </button>
                </footer>
            </form>
        </field>
    </record>
</odoo>
