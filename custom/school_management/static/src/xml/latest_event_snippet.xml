<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="school_management.latest_event">
        <section>
            <div class="container py-5">
                <div class="col-md-12">
                    <h2>Latest Events</h2>
                    <h4>Get ready to the day</h4>
                </div>
                <section class="school_event_snippet pb-5 row row-cols-1 row-cols-md-4 pt-2">
                    <t t-foreach="result" t-as="event" t-key="event.id">
                        <div class="col mb-4">
                            <a class="card text-decoration-none" t-att-href="`/event/${event.name.toLowerCase().replaceAll(' ','-')}-${event.id}/register`">
                            <img t-att-src="event.background_image_url" class="card-img-top" alt="..."/>
                            <div class="card-body">
                                <h5 class="card-title" t-out="event.name"/>
                                <p><span t-out="event.club_id[1]"/></p>
                                <p class="text-muted card-text">
                                    <i class="fa fa-calendar me-2"/>
                                    <span t-out="`${event.date_begin.day} ${event.date_begin.month} ${event.date_begin.year}`"/> &#8594;
                                    <span t-out="`${event.date_end.day} ${event.date_end.month} ${event.date_end.year}`"/>
                                </p>
                            </div>
                            </a>
                        </div>
                    </t>
                </section>
            </div>
        </section>
    </t>
    <t t-name="school_management.carousel_event">
        <section class="school_carousel_event_snippet">
            <div id="carouselExampleDark" class="carousel slide">
                <div class="carousel-indicators">
                    <t t-set="event_count" t-value="0"/>
                    <button type="button" data-bs-target="#carouselExampleDark" t-att-data-bs-slide-to="event_count" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <t t-foreach="result" t-as="event" t-key="event.id">
                        <button type="button" data-bs-target="#carouselExampleDark" t-att-data-bs-slide-to="event_count" aria-label="Slide 2"></button>
                        <t t-set="event_count" t-value="event_count+1"/>
                    </t>
                </div>
                <div class="carousel-inner">
                    <t t-foreach="result" t-as="event" t-key="event.id">
                        <t t-if="result[0] == event" t-set="active" t-value="`active`"/>
                        <t t-if="result[0] != event" t-set="active" t-value="``"/>
                        <div t-att-class="active" class="carousel-item overflow-hidden"
                             style="background-color: #000; height: 50vh" data-bs-interval="10000">
                            <img t-att-src="event.background_image_url" class="d-block w-100" alt="..." style="opacity:0.5"/>
                            <div class="carousel-caption p-3 d-none d-md-block">
                                <h3 t-out="event.name"/>
                                <p>
                                     <i class="fa fa-calendar me-2"/>
                                    <span t-out="`${event.date_begin.day} ${event.date_begin.month} ${event.date_begin.year}`"/> &#8594;
                                    <span t-out="`${event.date_end.day} ${event.date_end.month} ${event.date_end.year}`"/>
                                </p>
                            </div>
                        </div>
                    </t>
                </div>
                <button class="carousel-control-prev" type="button" onclick="$(this).parent('#carouselExampleDark').carousel('prev');" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" onclick="$(this).parent('#carouselExampleDark').carousel('next');"  data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </section>
    </t>
</templates>