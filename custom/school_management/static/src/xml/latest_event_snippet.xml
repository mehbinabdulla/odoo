<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="school_management.latest_event">
        <section>
            <div class="container py-5">
                <div class="col-md-12">
                    <h2>Latest Events</h2>
                    <h4>Get ready to the day</h4>
                </div>
                <section class="school_event_snippet pb-5 row row-cols-1 row-cols-md-4 pt-2">
                    <t t-foreach="result" t-as="event" t-key="event.id">
                        <div class="col mb-4">
                            <a class="card text-decoration-none" t-att-href="`/event/${event.name.toLowerCase().replaceAll(' ','-')}-${event.id}/register`">
                            <img t-att-src="event.background_image_url" class="card-img-top" alt="..."/>
                            <div class="card-body">
                                <h5 class="card-title" t-out="event.name"/>
                                <p><span t-out="event.club_id[1]"/></p>
                                <p class="text-muted card-text">
                                    <i class="fa fa-calendar me-2"/>
                                    <span t-out="`${event.date_begin.day} ${event.date_begin.month} ${event.date_begin.year}`"/> &#8594;
                                    <span t-out="`${event.date_end.day} ${event.date_end.month} ${event.date_end.year}`"/>
                                </p>
                            </div>
                            </a>
                        </div>
                    </t>
                </section>
            </div>
        </section>
    </t>
    <t t-name="school_management.carousel_event">
        <section class="school_carousel_event_snippet">
            <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
                <ol class="carousel-indicators">
                    <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
                    <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
                    <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
                </ol>
                <div class="carousel-inner">
                    <div class="carousel-item active">
                      <img class="d-block w-100" src="..." alt="First slide"/>
                    </div>
                    <div class="carousel-item">
                        <img class="d-block w-100" src="..." alt="Second slide"/>
                    </div>
                    <div class="carousel-item">
                        <img class="d-block w-100" src="..." alt="Third slide"/>
                    </div>
                </div>
                <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        </section>
    </t>
</templates>