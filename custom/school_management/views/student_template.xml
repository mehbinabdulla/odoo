<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="students_list_template" name="Events list">
        <t t-call="website.layout">
            <div class="container mt-3 mb-4">
                <div class="o_wevent_index_topbar_filters d-flex d-print-none align-items-center justify-content-end flex-wrap gap-2 w-100">
                    <h4 class="h4 my-0 me-auto pe-sm-4">Students</h4>
                    <a href="/registration" class="btn btn-primary">New</a>
                </div>
            </div>
            <!-- No events -->
            <div t-if="not students" class="col-12 text-center">
                <h3>No students registered yet</h3>
                <p>We couldn't find any student registered at this moment.</p>
                <div class="o_not_editable my-3" groups="event.group_event_user">
                    <a class="o_wevent_cta btn" target="_blank" href="/registration">
                        <span class="fa fa-plus me-1"/> Register a Student
                    </a>
                </div>
            </div>
            <!-- List -->
            <div class=" container mt-3 mb-4">
                <div id="o_wevent_index_main_col" class="col-md mb-3 opt_events_list_columns">
                    <div class="row g-4 g-lg-3 g-xxl-4">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th scope="col">Sl. No.</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Last</th>
                                    <th scope="col">Handle</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="order" t-value="0"/>
                                    <t t-foreach="students" t-as="student">
                                        <tr>
                                            <t t-set="order" t-value="order+1"/>
                                            <th scope="row"><span t-out="order"/></th>
                                            <td><span t-out="student.name"/></td>
                                            <td>Otto</td>
                                            <td>@mdo</td>
                                        </tr>
                                    </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="student_registration_form_template" name="Registration Form">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_title parallax bg-black-50 pt24 pb24">
                    <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Student Registration</h1>
                    </div>
                </section>
                <section class="s_text_block pt40 pb40">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-7 mt-4 mt-lg-0">
                                <p class="lead">
                                    Now you can register students from our website.<br/>
                                    Also see the registrations from here.
                                </p>
                                <t t-if="error">
                                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                        <strong>Holy guacamole!</strong> You should check in on some of those fields below.
                                    </div>
                                </t>
                                <section>
                                    <div class="container">
                                        <form id="form_student_registration" action="/register_student/" method="post" enctype="multipart/form-data">
                                            <div class="row">
                                                <div class="my-4">
                                                    <h5 class="mb-3">Personal Details</h5>
                                                    <hr/>
                                                </div>
                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="first_name">First Name *</label>
                                                    <input id="first_name" type="text" class="form-control" name="first_name" required=""/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="last_name">Last Name *</label>
                                                    <input id="last_name" type="text" class="form-control" name="last_name" required=""/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="email">Email *</label>
                                                    <input id="email" type="email" class="form-control" name="email" required=""/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="mobile">Mobile *</label>
                                                    <input id="mobile" type="tel" class="form-control" name="mobile" required=""/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="dob">Date of Birth *</label>
                                                    <input id="dob" type="date" class="form-control" name="dob" required=""/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="age">Age</label>
                                                    <input id="age" type="number" class="form-control" name="age" readonly=""/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="aadhaar">Aadhaar Number</label>
                                                    <input id="aadhaar" type="number" class="form-control" name="aadhaar"/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="gender">Gender *</label>
                                                    <select class="form-select" name="gender" id="gender" required="">
                                                        <option value="male" selected="">Male</option>
                                                        <option value="female">Female</option>
                                                        <option value="other">Other</option>
                                                    </select>
                                                </div>
    
                                                <div class="my-4">
                                                    <h5 class="mb-3">Academic Details</h5>
                                                    <hr/>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="class_id">Class *</label>
                                                    <select name="class_id" id="class_id" class="form-select" required="">
                                                        <t t-foreach="request.env['school.class'].sudo().search([])" t-as="school_class">
                                                            <option t-att-value="school_class.id">
                                                                <t t-out="school_class.name"/>
                                                            </option>
                                                        </t>
                                                    </select>
                                                </div>
    
                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="department_id">Department *</label>
                                                    <select name="department_id" id="department_id" class="form-select" required="">
                                                        <t t-foreach="request.env['school.department'].sudo().search([])" t-as="school_dept">
                                                            <option t-att-value="school_dept.id">
                                                                <t t-out="school_dept.name"/>
                                                            </option>
                                                        </t>
                                                    </select>
                                                </div>
    
                                                <div class="mb-0 py-2 col-12 text-end">
                                                    <span name="s_website_form_result" id="s_website_form_result"></span>
                                                    <input type="submit" class="btn btn-primary" value="Submit"/>
                                                </div>
    
                                                <t t-if="error">
                                                    <span t-out="error"/>
                                                </t>
                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>
    


    <record id="website_student_registration_menu" model="website.menu">
        <field name="name">Registrations</field>
        <field name="url">/registration</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" type="int">20</field>
    </record>
     <record id="website_leave_menu" model="website.menu">
       <field name="name">Students</field>
       <field name="url">/students</field>
       <field name="parent_id" ref="website.main_menu"/>
       <field name="sequence" type="int">15</field>
   </record>
</odoo>