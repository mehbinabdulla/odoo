<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="school_department_list" model="ir.ui.view">
        <field name="name">school.department.list</field>
        <field name="model">school.department</field>
        <field name="arch" type="xml">
            <list string="Department">
                <field name="name"/>
                <field name="hod_id"/>
            </list>
        </field>
    </record>

    <record id="school_department_form" model="ir.ui.view">
        <field name="name">school.department.form</field>
        <field name="model">school.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <div class="oe_title">
                        <span>Department Name</span>
                        <h1><field name="name" placeholder="eg: UP"/></h1>
                    </div>
                    <group class="col-6">
                        <field name="hod_id" placeholder="eg: John Doe"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">school.department</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>
</odoo>