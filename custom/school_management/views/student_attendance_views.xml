<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_student_attendance_list" model="ir.ui.view">
        <field name="name">student.attendance.list</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" sample="1">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="date"/>
                <field name="state"
                       decoration-success="state == 'present'"
                       decoration-danger="state == 'absent'"
                       widget="badge"/>
            </list>
        </field>
    </record>


    <record id="view_student_attendance_form" model="ir.ui.view">
        <field name="name">student.attendance.form</field>
        <field name="model">student.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <div class="oe_title">
                        <label for="student_id"/>
                        <h1><field name="student_id" placeholder="eg: John Doe"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="class_id" placeholder="eg: Class 1"/>
                            <field name="date" placeholder="eg: 10/10/2010"/>
                            <field name="state" widget="selection_badge"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_student_attendance">
        <field name="name">Attendance</field>
        <field name="res_model">student.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p><p>
            </p>
        </field>
    </record>
</odoo>