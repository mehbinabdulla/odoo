<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="school_academic_year_list" model="ir.ui.view">
        <field name="name">school.academic.year.list</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Year" sample="1">
                <field name="name"/>
                <field name="start_date" string="Start Date"/>
                <field name="end_date" string="End Date"/>
            </list>
        </field>
    </record>

    <record id="school_academic_year_form" model="ir.ui.view">
        <field name="name">school.academic.year.form</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <sheet>
                    <div class="oe_title">
                        <span>Year Title</span>
                        <h1><field name="name" placeholder="eg: 2024-25"/></h1>
                    </div>
                    <group class="col-6">
                        <field name="start_date" widget="daterange" options="{'always_range':true,'end_date_field':'end_date'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">school.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>
</odoo>