<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="student_leaves_list_template" name="Leaves">
        <t t-call="website.layout">
            <section class="s_title parallax bg-black-50 pt24 pb24">
                <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                <div class="o_we_bg_filter bg-black-50"/>
                <div class="container o_wevent_index_topbar_filters d-flex d-print-none align-items-center justify-content-end flex-wrap gap-2 w-100">
                    <h1 class="h1 my-0 me-auto pe-sm-4">Leaves</h1>
                    <a href="/leaves/new" class="btn btn-outline-light">New</a>
                </div>
            </section>
            <!-- No events -->
            <div t-if="not leaves" class="pt152 col-12 text-center">
                <h3>No leaves created yet</h3>
                <p>We couldn't find any leave created at this moment.</p>
                <div class="o_not_editable my-3" groups="event.group_event_user">
                    <a class="o_wevent_cta btn" href="/leaves/new">
                        <span class="fa fa-plus me-1"/> Create a Leave
                    </a>
                </div>
            </div>
            <!-- List -->
            <div class=" container mt-3 mb-4">
                <div id="o_wevent_index_main_col" class="col-md mb-3 opt_events_list_columns">
                    <div class="row g-4 g-lg-3 g-xxl-4">
                        <table class="table table-striped table-hover table-responsive">
                            <thead t-if="leaves">
                                <tr>
                                    <th scope="col">Sl. No.</th>
                                    <th scope="col">Name</th>
                                    <th scope="col">Class</th>
                                    <th scope="col">No. of Days</th>
                                    <th scope="col">Start Date</th>
                                    <th scope="col">End Date</th>
                                    <th scope="col">Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="order" t-value="0"/>
                                    <t t-foreach="leaves" t-as="leave">
                                        <tr>
                                            <t t-set="order" t-value="order+1"/>
                                            <th scope="row"><span t-out="order"/></th>
                                            <td><span t-out="leave.student_id.name"/></td>
                                            <td><span t-out="leave.class_id.name"/></td>
                                            <td><span t-out="leave.number_of_days"/></td>
                                            <td><span t-out="leave.date_from"/></td>
                                            <td><span t-out="leave.date_to"/></td>
                                            <td>
                                                <t t-if="leave.is_half_day">
                                                    <span>Half Day</span><![CDATA[&nbsp;]]>(<span t-field="leave.half_day"/>)
                                                </t>
                                                <t t-else="">
                                                    <span>Full Day</span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="student_leave_create_form_template" name="Create Leave">
        <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
                <section class="s_title parallax bg-black-50 pt24 pb24">
                    <span class="s_parallax_bg oe_img_bg" style="background-image: url('/web/image/website.s_parallax_default_image'); background-position: 50% 0;"/>
                    <div class="o_we_bg_filter bg-black-50"/>
                    <div class="container">
                        <h1>Create Leave</h1>
                    </div>
                </section>
                <section class="s_text_block pt40 pb40">
                    <div class="container">
                        <div class="row">
                            <div class="col-lg-7 mt-4 mt-lg-0">
                                <p class="lead">
                                    Now you can create leaves from our website.<br/>
                                    Also see the leaves from here.
                                </p>
                                <t t-if="error">
                                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                                        <strong>Error:</strong> <span t-out="error"/>
                                    </div>
                                </t>
                                <t t-if="success">
                                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                                        <strong>Success:</strong> <span t-out="success"/>
                                    </div>
                                </t>
                                <section>
                                    <div class="container">
                                        <form id="form_leave_creation" action="/leaves/create" method="post" enctype="multipart/form-data">
                                            <div class="row">

                                                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="student_id">Student *</label>
                                                    <select class="form-select" id="student_id" required="" name="student_id">
                                                        <option value="">Select the student</option>
                                                        <t t-foreach="request.env['student'].sudo().search([])" t-as="student">
                                                            <option t-att-value="student.id" t-att-selected="str(values.get('student_id')) == str(student.id)">
                                                                <t t-out="student.name"/>
                                                            </option>
                                                        </t>
                                                    </select>
                                                </div>

                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="class_id">Class *</label>
                                                    <input id="class_name" type="text" class="form-control" placeholder="Class" name="class_name" t-att-value="values.get('class_name')" readonly=""/>
                                                    <input id="class_id" type="hidden" class="form-control" name="class_id" t-att-value="values.get('class_id')"/>
                                                </div>

                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="date_from">Start Date *</label>
                                                    <input id="date_from" type="date" class="form-control" name="date_from" required="" t-att-value="values.get('date_from')"/>
                                                </div>

                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="date_to">End Date *</label>
                                                    <input id="date_to" type="date" class="form-control" name="date_to" required="" t-att-value="values.get('date_to')"/>
                                                </div>

                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="is_half_day">Half Day</label>
                                                    <div class="input-group mb-3">
                                                        <div class="input-group-text">
                                                            <input id="is_half_day" name="is_half_day" class="form-check-input mt-0" type="checkbox" value="true"/>
                                                        </div>
                                                         <select required="" class="form-select" id="half_day" name="half_day">
                                                             <option id="option_fn" value="fn">Forenoon</option>
                                                             <option id="option_an" value="an">Afternoon</option>
                                                          </select>
                                                    </div>
                                                </div>

                                                <div class="mb-3 col-lg-6">
                                                    <label class="form-label" for="number_of_days">Duration</label>
                                                    <input id="number_of_days" type="text" class="form-control" placeholder="0" name="number_of_days" t-att-value="values.get('number_of_days')" readonly=""/>
                                                </div>

                                                <div class="mb-3 col-lg-12">
                                                    <label class="form-label" for="reason">Reason *</label>
                                                    <textarea id="reason" class="form-control" placeholder="Provide the reason" name="reason" t-att-value="values.get('reason')" required=""/>
                                                </div>

                                                <div class="mb-0 py-2 col-12 text-end">
                                                    <span name="s_website_form_result" id="s_website_form_result"/>
                                                    <input type="submit" class="btn btn-primary" value="Create"/>
                                                </div>

                                            </div>
                                        </form>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </template>

    <record id="website_leave_menu" model="website.menu">
       <field name="name">Leaves</field>
       <field name="url">/leaves</field>
       <field name="parent_id" ref="website.main_menu"/>
       <field name="sequence" type="int">16</field>
     </record>

</odoo>