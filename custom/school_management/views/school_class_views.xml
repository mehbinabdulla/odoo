<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="school_class_list" model="ir.ui.view">
        <field name="name">school.class.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list string="Class" sample="1">
                <field name="name"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <record id="school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_title">
                        <span>Class</span>
                        <h1><field name="name" placeholder="eg: Class 1"/></h1>
                    </div>
                    <group class="col-6">
                        <field name="department_id" placeholder="eg: UP"/>
                        <field name="hod_id" placeholder="eg: John Doe"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_school_class">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p><p>
            </p>
        </field>
    </record>
</odoo>