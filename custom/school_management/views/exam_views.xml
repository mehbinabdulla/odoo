<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_school_exam_list" model="ir.ui.view">
        <field name="name">school.exam.list</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <list string="Exam" sample="1" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="class_id"/>
                <field name="paper_ids"/>
                <field name="state"
                       decoration-success="state == 'assigned'"
                       decoration-info="state == 'draft'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_school_exam_paper_list" model="ir.ui.view">
        <field name="name">school.exam.paper.list</field>
        <field name="model">school.exam.paper</field>
        <field name="arch" type="xml">
            <list string="Exam" editable="bottom">
                <field name="subject_id"/>
                <field name="pass_mark"/>
                <field name="max_mark"/>
            </list>
        </field>
    </record>


    <record id="view_school_exam_form" model="ir.ui.view">
        <field name="name">school.exam.form</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <form string="Exam">
                <header>
                    <button name="action_exam_assignment" string="Assign" class="oe_highlight" type="object" invisible="state=='assigned'"/>
                    <button name="action_exam_assignment" string="Reset to Draft" type="object" invisible="state=='draft'"/>
                     <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Exam Title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="class_id" placeholder="eg: Class 1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Papers">
                            <field name="paper_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_school_exam">
        <field name="name">Exams</field>
        <field name="res_model">school.exam</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p><p>
            </p>
        </field>
    </record>
</odoo>