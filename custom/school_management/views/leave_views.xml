<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="view_student_leave_kanban">
        <field name="name">student.leave.kanban</field>
        <field name="model">student.leave</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="name"/>
                <field name="student_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days"/>
                <templates>
                    <t t-name="card" class="row g-0">
                        <div class="ms-3 col">
                            <span class="badge rounded-pill float-end"><field name="number_of_days"/> days</span>
                            <field class="fw-bold fs-5" name="student_id"/>
                            <div class="mb-1">
                                <span class="text-muted">from </span>
                                <field name="date_from" readonly="1"/>
                                <span class="text-muted"> to </span>
                                <field name="date_to" readonly="1"/>
                            </div>
                            <field name="name" nolabel="1"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="view_student_leave_list">
        <field name="name">student.leave.list</field>
        <field name="model">student.leave</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="student_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="number_of_days"/>
            </list>
        </field>
    </record>

     <record id="view_student_leave_form" model="ir.ui.view">
        <field name="name">student.leave.form</field>
        <field name="model">student.leave</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id" widget="many2one_avatar_user" options="{'no_quick_create': True, 'no_create': True}"/>
                            <field name="date_from" string="Period" widget="daterange" invisible="is_half_day" options="{'always_range':true,'end_date_field':'date_to'}"/>
                            <field name="date_from" string="Period" invisible="not is_half_day"/>
                            <field name="date_to" invisible="1"/>
                            <label for="is_half_day"/>
                            <div class="o_row">
                                <field name="is_half_day"/>
                                <field name="half_day" invisible="not is_half_day"/>
                            </div>
                            <field name="number_of_days"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Reason">
                            <field name="reason" placeholder="Type the reason for the leave..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_leave" model="ir.actions.act_window">
        <field name="name">Leaves</field>
        <field name="res_model">student.leave</field>
        <field name="view_mode">kanban,list,form</field>
         <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>
</odoo>