<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <record id="view_student_leave_form" model="ir.ui.view">
        <field name="name">student.leave.form</field>
        <field name="model">student.leave</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h2><field name="name"/></h2>
                    </div>
                    <group>
                        <field name="student_id"/>
                        <field name="date_from" widget="daterange" options="{'always_range':true,'end_date_field':'date_to'}"/>
                        <field name="date_to" widget="daterange" options="{'always_range':true,'start_date_field':'date_from'}"/>
                        <field name="is_half_day"/>
                        <field name="half_day"/>
                        <field name="number_of_days"/>
                    </group>
                    <notebook>
                        <page string="Reason">
                            <field name="reason"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_student_leave" model="ir.actions.act_window">
        <field name="name">Leaves</field>
        <field name="res_model">student.leave</field>
        <field name="view_mode">kanban,list,form</field>
         <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new record
            </p>
        </field>
    </record>
</odoo>