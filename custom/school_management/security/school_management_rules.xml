<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="school_management_student_registration_rule" model="ir.rule">
        <field name="name">Student</field>
        <field ref="model_student" name="model_id"/>
        <field name="domain_force">[('partner_id','=',user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>
    <record id="school_management_student_leave_rule" model="ir.rule">
        <field name="name">Leave</field>
        <field ref="model_student_leave" name="model_id"/>
        <field name="domain_force">[('student_id.id','=',user.partner_id.student_id.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>
    <record id="school_management_student_exam_rule" model="ir.rule">
        <field name="name">Exam</field>
        <field ref="model_school_exam" name="model_id"/>
        <field name="domain_force">[('class_id','=',user.partner_id.student_id.class_id.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>
    <record id="school_management_student_club_rule" model="ir.rule">
        <field name="name">Club</field>
        <field ref="model_school_club" name="model_id"/>
        <field name="domain_force">[('student_ids','in',user.partner_id.student_id.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>
    <record id="school_management_partner_rule" model="ir.rule">
        <field name="name">Partner</field>
        <field ref="base.model_res_partner" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>
</odoo>