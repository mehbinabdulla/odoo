<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="school_management_student_registration_rule" model="ir.rule">
        <field name="name">Registration: Own record</field>
        <field ref="model_student" name="model_id"/>
        <field name="domain_force">[('partner_id.student_id','=',user.partner_id.student_id.id),('school_id.id', '=', company_id)]</field>
        <field name="groups" eval="[(4, ref('group_school_management_student'))]"/>
    </record>

    <record id="school_management_staff_registration_rule" model="ir.rule">
        <field name="name">Registration: All records</field>
        <field ref="model_student" name="model_id"/>
        <field name="domain_force">[(1,'=',1), ('school_id.id', '=', company_id)]</field>
        <field name="groups" eval="[(4, ref('group_school_management_teacher')), (4, ref('group_school_management_staff'))]"/>
    </record>

    <record id="school_management_student_leave_rule" model="ir.rule">
        <field name="name">Leave Own Leaves:</field>
        <field ref="model_student_leave" name="model_id"/>
        <field name="domain_force">[('student_id.id','=',user.partner_id.student_id.id), ('student_id.school_id.id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>

    <record id="school_management_staff_leave_rule" model="ir.rule">
        <field name="name">Leave: All leaves</field>
        <field ref="model_student_leave" name="model_id"/>
        <field name="domain_force">[(1,'=',1), ('student_id.school_id.id', '=', user.company_id.id)]</field>
        <field name="groups" eval="[(4, ref('group_school_management_teacher')), (4, ref('group_school_management_staff'))]"/>
    </record>

    <record id="school_management_student_exam_rule" model="ir.rule">
        <field name="name">Exam: Own exams</field>
        <field ref="model_school_exam" name="model_id"/>
        <field name="domain_force">[('class_id','=',user.partner_id.student_id.class_id.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>

    <record id="school_management_staff_exam_rule" model="ir.rule">
        <field name="name">Exam: All exams</field>
        <field ref="model_school_exam" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_school_management_teacher')), (4, ref('group_school_management_staff'))]"/>
    </record>

    <record id="school_management_student_club_rule" model="ir.rule">
        <field name="name">Club: Own clubs</field>
        <field ref="model_school_club" name="model_id"/>
        <field name="domain_force">[('student_ids','=',user.partner_id.student_id.id)]</field>
        <field name="groups" eval="[(4, ref('school_management.group_school_management_student'))]"/>
    </record>

    <record id="school_management_teacher_club_rule" model="ir.rule">
        <field name="name">Club: All Clubs (Read only)</field>
        <field ref="model_school_club" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_school_management_teacher'))]"/>
    </record>

    <record id="school_management_staff_club_rule" model="ir.rule">
        <field name="name">Club: All Clubs</field>
        <field ref="model_school_club" name="model_id"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('group_school_management_staff'))]"/>
    </record>
</odoo>