<?xml version="1.0" encoding="utf-8"?>
<odoo>
   <template id="report_student">
       <t t-call="web.html_container">
           <t t-call="web.external_layout">
               <div class="page">
                   <div class="oe_structure"/>
                   <t t-set="layout_document_title">
                       <span>Student Report</span>
                   </t>
                   <div class="row mb-4" id="informations">
                       <div class="col" name="printing_date">
                            <strong>Date</strong>
                            <div t-esc="datetime.datetime.now().strftime('%Y-%m-%d')" t-options='{"widget": "date"}'>0000-00-00</div>
                        </div>
                   </div>
                   <table class="o_has_total_table table o_main_table table-borderless">
                        <thead style="display: table-row-group">
                            <tr>
                                <th name="th_registration" class="text-start">Registration ID</th>
                                <th name="th_name">Name</th>
                                <th name="th_class">Class</th>
                                <th name="th_email">Email</th>
                                <th name="th_mobile" class="text-end text-nowrap">Mobile</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">
                            <t t-foreach="docs" t-as="line">
                                <tr t-att-class="'fw-bold o_line_section'">
                                    <td name="td_registration" class="text-start"><span t-field="line.reg_id"/></td>
                                    <td name="td_name"><span t-field="line.name"/></td>
                                    <td name="td_class"><span t-field="line.class_id.name"/></td>
                                    <td name="td_email"><span t-field="line.email"/></td>
                                    <td name="td_mobile" class="text-end text-nowrap"><span t-field="line.mobile"/></td>
                                </tr>
                            </t>
                        </tbody>
                   </table>
               </div>
           </t>
       </t>
   </template>
</odoo>