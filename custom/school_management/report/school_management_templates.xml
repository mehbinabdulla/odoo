    <template id="report_event">
       <t t-call="web.html_container">
           <t t-call="web.external_layout">
               <div class="page">
                   <div class="oe_structure"/>
                   <t t-set="layout_document_title">
                       <span>Event Report</span>
                   </t>
                   <div class="row mb-4" id="informations">
                       <div class="col" name="duration">
                            <strong>Duration</strong>
                            <div t-esc="data.get('duration')"></div>
                       </div>
                       <t t-if="len(data.get('club_name')) &gt; 0">
                           <div class="col" name="club_info">
                                <strong>Club</strong>
                                <div t-esc="', '.join(data.get('club_name'))">N/A</div>
                            </div>
                       </t>
                       <div class="col" name="printing_date">
                            <strong>Printing Date</strong>
                            <div t-esc="datetime.datetime.now().strftime('%Y-%m-%d')" t-options='{"widget": "date"}'>0000-00-00</div>
                        </div>
                   </div>
                   <table class="o_has_total_table table o_main_table table table-condensed table-borderless">
                        <thead style="display: table-row-group">
                            <tr>
                                <th name="th_event" class="text-start"><strong>Event</strong></th>
                                <th name="th_club"><strong>Club</strong></th>
                                <th name="th_st_date"><strong>Start Date</strong></th>
                                <th name="th_ed_date"><strong>End Date</strong></th>
                                <th name="th_state" class="text-end text-nowrap"><strong>Status</strong></th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">
                            <t t-foreach="docs" t-as="event">
                                <tr t-att-class="'fw-bold o_line_section'">
                                    <td name="td_event" class="text-start"><span t-field="event.name"/></td>
                                    <td name="td_club"><span t-field="event.club_id.name"/></td>
                                    <td name="td_st_date"><span t-field="event.date_begin"/></td>
                                    <td name="td_ed_date"><span t-field="event.date_end"/></td>
                                    <td name="td_state" class="text-end text-nowrap"><span t-field="event.stage_id.name"/></td>
                                </tr>
                            </t>
                        </tbody>
                   </table>
               </div>
           </t>
       </t>
   </template>

    <template id="report_club">
       <t t-call="web.html_container">
           <t t-call="web.external_layout">
               <div class="page">
                   <div class="oe_structure"/>
                   <t t-set="layout_document_title">
                       <span>Club Report</span>
                   </t>
                   <div class="row mb-4" id="informations">
                       <t t-if="len(set(docs)) == 1 and len(data.get('student_name')) &gt; 0">
                           <div class="col" name="class_info">
                                <strong>Club</strong>
                                <div t-esc="docs.name"></div>
                            </div>
                       </t>
                       <t t-if="len(data.get('student_name')) == 1">
                           <div class="col" name="department_info">
                                <strong>Student</strong>
                                <div t-esc="', '.join(data.get('student_name'))"></div>
                            </div>
                       </t>
                       <div class="col" name="printing_date">
                            <strong>Printing Date</strong>
                            <div t-esc="datetime.datetime.now().strftime('%Y-%m-%d')" t-options='{"widget": "date"}'>0000-00-00</div>
                        </div>
                   </div>
                   <t t-if="len(set(docs)) != 0 and len(data.get('student_name')) == 0">
                       <t t-foreach="docs" t-as="club">
                           <div class="row mb-4" id="informations"></div>
                           <h4><strong><span t-esc="club.name"/></strong></h4>
                           <table class="o_has_total_table table o_main_table table table-condensed table-borderless">
                                <thead style="display: table-row-group">
                                    <tr>
                                        <t t-if="len(data.get('student_name')) &lt;= 0">
                                            <th name="th_student" class="text-start"><strong>Student</strong></th>
                                            <th name="th_class"><strong>Class</strong></th>
                                            <th name="th_mobile" class="text-end text-nowrap"><strong>Mobile</strong></th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody class="sale_tbody">
                                    <t t-foreach="club.student_ids" t-as="student">
                                        <tr t-att-class="'fw-bold o_line_section'">
                                            <td name="td_student" class="text-start"><span t-field="student.name"/></td>
                                            <td name="td_class"><span t-field="student.class_id"/></td>
                                            <td name="td_mobile" class="text-end text-nowrap"><span t-field="student.mobile"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                           </table>
                       </t>
                   </t>
                   <t t-else="">
                       <table class="o_has_total_table table o_main_table table table-condensed table-borderless">
                            <thead style="display: table-row-group">
                                <tr>
                                    <t t-if="len(data.get('student_name')) == 1">
                                        <th name="th_club" class="text-start"><strong>Club</strong></th>
                                        <th name="th_count"><strong>No. of Students</strong></th>
                                    </t>
                                    <t t-if="len(data.get('student_name')) &gt; 1">
                                        <th name="th_student" class="text-start"><strong>Student</strong></th>
                                        <th name="th_count"><strong>Clubs</strong></th>
                                    </t>
                                </tr>
                            </thead>
                            <tbody class="sale_tbody">
                                <t t-foreach="docs" t-as="club">
                                    <t t-if="len(data.get('student_name')) == 1">
                                        <tr t-att-class="'fw-bold o_line_section'">
                                            <td name="td_club" class="text-start"><span t-field="club.name"/></td>
                                            <td name="td_count"><span t-esc="len(club.student_ids)"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-if="len(data.get('student_name')) &gt; 1">
                                    <t t-foreach="data.get('student_name')" t-as="student">
                                        <tr t-att-class="'fw-bold o_line_section'">
                                            <td name="td_name" class="text-start"><span t-esc="student"/></td>
                                            <td name="td_count"><span t-esc="', '.join([club.name for club in docs])"/></td>
                                        </tr>
                                    </t>
                                </t>
                            </tbody>
                       </table>
                       <br/><br/>
                   </t>
               </div>
           </t>
       </t>
   </template>
</odoo>