                                    <t t-if="len(data.get('class_name')) != 1">
                                        <td name="td_class"><span t-field="exam.class_id.name"/></td>
                                    </t>
                                    <td name="td_cr_date"><span t-field="exam.create_date"/></td>
                                    <td name="td_state" class="text-end text-nowrap"><span t-field="exam.state"/></td>
