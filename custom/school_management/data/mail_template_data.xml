<odoo>
   <data>
       <record id="employee_event_mail_template" model="mail.template">
            <field name="name">Event: Reminder</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="subject">{{ object.company_id.name }}</field>
            <field name="email_from">me@gmail.com</field>
            <field name="partner_to">{{ object.env['res.partner'].email }}</field>
            <field name="description">Add Description</field>
            <field name="body_html" type="html">
               <div>
                   <p>
                       Hello {{ object.partner_id.id }},
                       <br/>
                       <br/>
                       {{ object.company_id.name }} is inviting you to the event.
                       <br/>
                       <br/>
                       <br/>{{ (object.user_id.email) }}
                       <br/>
                       <br/>
                   </p>
               </div>
           </field>
       </record>
   </data>
</odoo>
