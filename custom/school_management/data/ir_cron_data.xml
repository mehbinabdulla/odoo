<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ir_cron_school_management_event_mail" model="ir.cron">
            <field name="name">School Management: Send mail to the employees</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="state">code</field>
            <field name="code">model.action_send_mail()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record id="ir_cron_school_management_attendance" model="ir.cron">
            <field name="name">School Management: Update Attendance</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="state">code</field>
            <field name="code">model.action_update_attendance()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>
    </data>
</odoo>