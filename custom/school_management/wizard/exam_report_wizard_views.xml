<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_exam_report_wizard_form" model="ir.ui.view">
        <field name="name">exam.report.wizard.form</field>
        <field name="model">exam.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="class_ids" placeholder="All" widget="many2many_tags" options="{'no_open': True, 'no_quick_create':True, 'no_create': True}"/>
                    </group>
                    <group>
                        <field name="student_ids" placeholder="All" widget="many2many_tags" options="{'no_open': True, 'no_quick_create':True, 'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button string="Print"
                            data-hotkey="p"
                            name="action_print_report"
                            type="object"
                            class="print btn-primary o_mail_send">
                    </button>
                     <button string="Print Excel"
                            data-hotkey="x"
                            name="action_print_xls"
                            type="object"
                            class="print btn-secondary o_mail_send">
                    </button>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_print_exam_report" model="ir.actions.act_window">
        <field name="name">Exam Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">exam.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_exam_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
