<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_leave_report_wizard_form" model="ir.ui.view">
        <field name="name">leave.report.wizard.form</field>
        <field name="model">leave.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="duration" widget="radio" options="{'horizontal': True}"/>
                    <group>
                        <field name="start_date" placeholder="All" invisible="duration != 'custom'"/>
                        <field name="class_ids" placeholder="All" widget="many2many_tags" options="{'no_open': True, 'no_quick_create':True, 'no_create': True}"/>
                    </group>
                    <group>
                        <field name="end_date" placeholder="All" invisible="duration != 'custom'"/>
                        <field name="student_ids" placeholder="All" widget="many2many_tags" options="{'no_open': True, 'no_quick_create':True, 'no_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button string="Print"
                            data-hotkey="q"
                            name="action_print_report"
                            type="object"
                            class="print btn-primary o_mail_send">
                    </button>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_print_leave_report" model="ir.actions.act_window">
        <field name="name">Leave Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">leave.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_leave_report_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
