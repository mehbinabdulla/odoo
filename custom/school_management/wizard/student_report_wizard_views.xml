<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_student_report_wizard_form" model="ir.ui.view">
        <field name="name">student.report.student.wizard.form</field>
        <field name="model">student.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="department_ids" placeholder="All" widget="many2many_tags" options="{'no_create': True, 'no_edit': True, 'no_quick_create': True}"/>
                    </group>
                    <group>
                        <field name="class_ids" placeholder="All" widget="many2many_tags" options="{'no_create': True, 'no_edit': True, 'no_quick_create': True}"/>
                    </group>
                </group>
                <footer>
                    <button string="Print PDF"
                            data-hotkey="p"
                            name="action_print_report"
                            type="object"
                            class="print btn-primary o_mail_send">
                    </button>
                    <button string="Print Excel"
                            data-hotkey="x"
                            name="action_print_xls"
                            type="object"
                            class="print btn-secondary o_mail_send">
                    </button>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_print_student_report" model="ir.actions.act_window">
        <field name="name">Student Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">student.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_student_report_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
