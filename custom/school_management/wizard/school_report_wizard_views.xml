<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="upload_sale_order_line_wizard_form" model="ir.ui.view">
        <field name="name">school.report.wizard.form</field>
        <field name="model">school.report.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="domain" widget="domain" />
                </group>
                <footer>
                    <button string="Print"
                            data-hotkey="q"
                            name="action_print_report"
                            type="object"
                            class="print btn-primary o_mail_send">
                    </button>
                </footer>
            </form>
        </field>
    </record>
</odoo>
