<?xml version="1.0"?>
<odoo>
    <record id="real_estate_orders_view_form" model="ir.ui.view">
        <field name="name">real.estate.orders.form</field>
        <field name="model">real.estate.orders</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="order_id" placeholder="New"/></h1>
                    </div>
                    <group>
                        <field name="partner_id" placeholder="eg: John Doe"/>
                        <field name="email" placeholder="eg: john@example.com"/>
                    </group>
                    <group>
                        <field name="property_id" placeholder="eg: 3BHK Flat"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="real_estate_view_list" model="ir.ui.view">
        <field name="name">real.estate.orders.list</field>
        <field name="model">real.estate.orders</field>
        <field name="arch" type="xml">
            <list string="Orders">
                <field name="order_id"/>
                <field name="partner_id"/>
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_real_estate_orders">
        <field name="name">Orders</field>
        <field name="res_model">real.estate.orders</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product
            </p><p>
                You must define a product for everything you sell or purchase,
                whether it's a storable product, a consumable or a service.
            </p>
        </field>
    </record>
</odoo>